option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: nyc_events.settings
    DJANGO_DEBUG: "False"
    # A new EB environment serves plain HTTP; set to "True" once an HTTPS
    # listener/certificate is added to the load balancer.
    DJANGO_SECURE_SSL_REDIRECT: "False"
  aws:elasticbeanstalk:container:python:
    WSGIPath: nyc_events.wsgi:application
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /healthz/
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /healthz/

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput"
    leader_only: true
